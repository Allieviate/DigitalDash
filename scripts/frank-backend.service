[Unit]
Description=FRANK HMI Backend

# mongodb.service is deliberately absent. The backend kept device
# preferences in MongoDB until that was replaced by a local JSON store
# at backend/data/devices.json, so there is no database to wait for.
After=network.target frank-can.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__/backend
Environment="PATH=__PROJECT_DIR__/backend/venv/bin"

# Holds SIGNAL_SOURCE, which decides whether the gauges are fed by the
# bench simulator or by real CAN frames. Deployment config, not a user
# setting - a dash that quietly reverts to simulation in front of a
# running engine shows a healthy idle whatever the engine is doing.
EnvironmentFile=__PROJECT_DIR__/backend/.env

ExecStart=__PROJECT_DIR__/backend/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
