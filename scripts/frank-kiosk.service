[Unit]
Description=FRANK HMI Kiosk Display

# network-online.target is deliberately absent.
#
# It used to be in both After= and Wants=, which told systemd to hold
# the kiosk until the network was up. Parked at a grocery store there
# is no network to come up, so that target does not fail quickly - it
# waits out its timeout, typically 90 to 120 seconds, and the driver
# stares at a black screen the whole time.
#
# Nothing here needs the internet. The frontend is served from disk on
# localhost and the backend reads a CAN bus. The only ordering that
# matters is that both are running and a display exists.
After=frank-frontend.service frank-display.service
Wants=frank-frontend.service frank-display.service

[Service]
Type=simple
User=__USER__
Environment=HOME=__HOME__
PAMName=login

# launch_kiosk.sh does its own waiting - for the frontend to answer and
# for a display socket to appear - and reports which one it is stuck on.
# A blind sleep here just delays that reporting.
ExecStart=__PROJECT_DIR__/scripts/launch_kiosk.sh

# on-failure, NOT always.
#
# Chromium exits 0 when it hands its URL to an instance that already
# holds the profile directory. Restart=always treats that clean exit as
# a reason to try again, which produced 376 restarts in one session
# while the screen never changed. on-failure lets a clean exit stay
# exited, and the launcher now exits non-zero on the cases that really
# are failures.
Restart=on-failure
RestartSec=5

# Stop retrying after five failures inside a minute. Without a limit, a
# genuine fault - no display, frontend down, a bad build - retries
# forever and buries the cause in a repeating log. Failed and stopped
# is easier to diagnose than failing on a loop.
StartLimitBurst=5
StartLimitIntervalSec=60

[Install]
WantedBy=multi-user.target
