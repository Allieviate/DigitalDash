<Window x:Class="DigitalDash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:DigitalDash.Converters"
        xmlns:microGauge="clr-namespace:MicroGauge.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">
    <Window.Resources>
        <!-- FIX: Use IMultiValueConverter for MultiBinding -->
        <converters:RpmToAngleMultiConverter x:Key="RpmToAngleConverter"/>
        <Storyboard x:Key="StartupStoryboard">
            <DoubleAnimation Storyboard.TargetName="StartupLogo"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1" BeginTime="0:0:0"/>
            <DoubleAnimation Storyboard.TargetName="StartupLogo"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:1" BeginTime="0:0:3"/>
            <DoubleAnimation Storyboard.TargetName="GaugeRoot"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:1" BeginTime="0:0:4"/>
        </Storyboard>
    </Window.Resources>
    <Grid Background="Black">
        <!-- Startup Logo -->
        <Image x:Name="StartupLogo"
               Source="pack://application:,,,/DigitalDash;component/Assets/Honda%20Frankenstein%20Logo.png"
               Width="300" Height="300"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Opacity="0"
               Panel.ZIndex="10"
               RenderTransformOrigin="0.507,0.733"/>

        <!-- Main Gauge Container -->
        <Grid x:Name="GaugeRoot"
              Opacity="0"
              Width="500" Height="500"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RenderOptions.BitmapScalingMode="HighQuality"
              SnapsToDevicePixels="True">
            <Grid Width="500" Height="500">
                <Image Source="pack://application:,,,/DigitalDash;component/Assets/Rpm%20Gauge.png"
                       Stretch="Fill"
                       Width="500" Height="500"/>
                <Image Source="pack://application:,,,/DigitalDash;component/Assets/Rpm%20Small%20Tacs.png"
                       Stretch="Fill" Width="500" Height="500"/>
                <Image Source="pack://application:,,,/DigitalDash;component/Assets/Rpm%20Medium%20Tacs.png"
                       Stretch="Fill" Width="500" Height="500"/>
                <Image Source="pack://application:,,,/DigitalDash;component/Assets/Rpm%20Large%20Tacs.png"
                       Stretch="Fill" Width="500" Height="500"/>
                <Image Source="pack://application:,,,/DigitalDash;component/Assets/Rpm%20Numbers.png"
                       Stretch="Fill" Width="500" Height="500"/>
                <Image Source="pack://application:,,,/DigitalDash;component/Assets/x1000%20Rpm.png"
                       Stretch="None"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,30"/>


                <microGauge:WpfGaugeRadial x:Name="RpmGauge"
                       Width="500"
                       Height="500"
                       MinValue="{Binding MinimumRpm, Mode=OneWay}"
                       MaxValue="{Binding MaximumRpm, Mode=OneWay}"
                       Value="{Binding CurrentRpm, Mode=OneWay}"
                       NeedleBrush="Transparent"
                       BackingBrush="Transparent"
                       TickBrush="Transparent"
                       MinorTickBrush="Transparent"
                       LabelFontBrush="Transparent"
                       ValueFontBrush="Transparent"/>
                <!-- TODO: Restore the gauge control after resolving the missing type/namespace issue. -->

                <Image Source="pack://application:,,,/DigitalDash;component/Assets/Rpm%20Needle.png"
                       Height="200"
                       Stretch="Uniform"
                       RenderTransformOrigin="0.5,0.85"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Center"
                       Margin="0,142,0,0"
                       IsHitTestVisible="False">
                    <Image.RenderTransform>
                        <RotateTransform>
                            <RotateTransform.Angle>
                                <MultiBinding Converter="{StaticResource RpmToAngleConverter}">
                                    <Binding Path="CurrentRpm" />
                                    <Binding Path="MinimumRpm" />
                                    <Binding Path="MaximumRpm" />
                                </MultiBinding>
                            </RotateTransform.Angle>
                        </RotateTransform>
                    </Image.RenderTransform>
                </Image>

                <Image Source="pack://application:,,,/DigitalDash;component/Assets/Rpm%20Needle%20Center.png"
                       Width="30" Height="30"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
