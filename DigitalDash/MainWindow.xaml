<Window x:Class="DigitalDash.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DigitalDash.Controls"
        xmlns:vm="clr-namespace:DigitalDash.ViewModels"
        Title="DigitalDash"
        Width="1920"
        Height="720"
        WindowStartupLocation="CenterScreen">

    <!-- Animated Radial Gradient Background -->
    <Window.Background>
        <RadialGradientBrush GradientOrigin="0.5,0.35"
                             Center="0.5,0.35"
                             RadiusX="0.9"
                             RadiusY="1.0">
            <GradientStop x:Name="BgInnerStop" Color="#2B2B2B" Offset="0.0" />
            <GradientStop x:Name="BgMidStop"   Color="#101010" Offset="0.25" />
            <GradientStop x:Name="BgOuterStop" Color="#000000" Offset="1.0" />
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Reusable "FloatingGaugeStyle" for both gauges -->
        <Style x:Key="FloatingGaugeStyle" TargetType="FrameworkElement">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black"
                                      BlurRadius="40"
                                      ShadowDepth="0"
                                      Opacity="0.55" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Indicator dot base -->
        <Style x:Key="IndicatorDotStyle" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Opacity" Value="0.15"/>
        </Style>

        <!-- Indicator text base -->
        <Style x:Key="IndicatorTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E6FFFFFF"/>
            <Setter Property="Opacity" Value="0.20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- ViewModel -->
    <Window.DataContext>
        <vm:DashViewModel />
    </Window.DataContext>

    <Grid Margin="30,10,30,20"
          Opacity="{Binding ClusterOpacity}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =========================
             TOP CENTER: SHIFT LIGHTS + MPH + GEAR + PHASE 1 UI
             ========================= -->

        <!-- SHIFT-LIGHT BAR (above MPH) -->
        <Grid Grid.ColumnSpan="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal"
                        Opacity="{Binding ShiftLightMasterOpacity}">
                <Ellipse Width="22" Height="22" Margin="4,0" Opacity="{Binding ShiftLight1}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF16A" Offset="-0.2" />
                            <GradientStop Color="#FF0000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="22" Height="22" Margin="4,0" Opacity="{Binding ShiftLight2}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF16A" Offset="-0.2" />
                            <GradientStop Color="#FF0000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="22" Height="22" Margin="4,0" Opacity="{Binding ShiftLight3}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF16A" Offset="-0.2" />
                            <GradientStop Color="#FF0000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="22" Height="22" Margin="4,0" Opacity="{Binding ShiftLight4}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF16A" Offset="-0.2" />
                            <GradientStop Color="#FF0000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="22" Height="22" Margin="4,0" Opacity="{Binding ShiftLight5}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF16A" Offset="-0.2" />
                            <GradientStop Color="#FF0000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="22" Height="22" Margin="4,0" Opacity="{Binding ShiftLight6}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF16A" Offset="-0.2" />
                            <GradientStop Color="#FF0000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="22" Height="22" Margin="4,0" Opacity="{Binding ShiftLight7}">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFF16A" Offset="-0.2" />
                            <GradientStop Color="#FF0000" Offset="1.0" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </StackPanel>
        </Grid>

        <!-- MPH + GEAR block -->
        <StackPanel Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,52,0,0"
                    Orientation="Vertical">

            <TextBlock Text="{Binding Speed, StringFormat={}{0:0}}"
                       FontSize="44"
                       FontWeight="Bold"
                       FontFamily="{StaticResource DashFont}"
                       Foreground="White"
                       HorizontalAlignment="Center" />

            <TextBlock Text="MPH"
                       FontSize="18"
                       FontFamily="{StaticResource DashFont}"
                       Foreground="#AAFFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,-6,0,8" />

            <!-- GEAR ROW: prev / current / next -->
            <!-- GEAR ROW: prev / current / next (LOCKED, NO WIGGLE) -->
            <Grid Margin="0,0,0,4"
      HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>

                <!-- PREVIOUS GEAR (faded) -->
                <TextBlock Grid.Column="0"
               Width="28"
               TextAlignment="Center"
               Text="{Binding PrevGearText}"
               FontSize="18"
               FontFamily="{StaticResource DashFont}"
               Foreground="#33FFFFFF"
               VerticalAlignment="Center"
               Typography.NumeralAlignment="Tabular"
               Typography.NumeralStyle="Lining"/>

                <!-- CURRENT GEAR (always white, never sticks red) -->
                <TextBlock Grid.Column="1"
               Width="42"
               TextAlignment="Center"
               Text="{Binding GearText}"
               FontSize="32"
               FontFamily="{StaticResource DashFont}"
               FontWeight="Bold"
               VerticalAlignment="Center"
               Typography.NumeralAlignment="Tabular"
               Typography.NumeralStyle="Lining">

                    <TextBlock.Foreground>
                        <SolidColorBrush Color="White"/>
                    </TextBlock.Foreground>

                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="1"/>

                            <Style.Triggers>

                                <!-- UPSHIFT: white flash (opacity only) -->
                                <DataTrigger Binding="{Binding FlashUpShift}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.35" To="1.0"
                                                     Duration="0:0:0.10"
                                                     AutoReverse="True"
                                                     FillBehavior="Stop"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>

                                <!-- DOWNSHIFT: red pulse, then RELEASE back to white -->
                                <DataTrigger Binding="{Binding FlashDownShift}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                                                    To="#FFDD4444"
                                                    Duration="0:0:0.12"
                                                    AutoReverse="True"
                                                    FillBehavior="Stop"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- NEXT GEAR (faded) -->
                <TextBlock Grid.Column="2"
               Width="28"
               TextAlignment="Center"
               Text="{Binding NextGearText}"
               FontSize="18"
               FontFamily="{StaticResource DashFont}"
               Foreground="#33FFFFFF"
               VerticalAlignment="Center"
               Typography.NumeralAlignment="Tabular"
               Typography.NumeralStyle="Lining"/>
            </Grid>

            <TextBlock Text="GEAR"
                       FontSize="14"
                       FontFamily="{StaticResource DashFont}"
                       Foreground="#AAFFFFFF"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- =========================
             PHASE 1: INDICATORS + FUEL/COOLANT (UNDER MPH/GEAR)
             ========================= -->

        <Grid Grid.ColumnSpan="2"
              HorizontalAlignment="Center"
              VerticalAlignment="Top"
              Margin="0,185,0,0">

            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">

                <!-- Indicators row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">

                    <!-- Left Turn -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Border Background="#FF28D86A">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource IndicatorDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeftTurn}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="◀" Margin="6,-1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IndicatorTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LeftTurn}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Check Engine -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Border Background="#FFFFB020">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource IndicatorDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CheckEngine}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="CEL" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IndicatorTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CheckEngine}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Maintenance -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                        <Border Background="#FF4AA3FF">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource IndicatorDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Maintenance}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="MAINT" Margin="6,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IndicatorTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Maintenance}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Right Turn -->
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FF28D86A">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource IndicatorDotStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightTurn}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="▶" Margin="6,-1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IndicatorTextStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RightTurn}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                </StackPanel>

                <!-- Fuel + Coolant -->
                <Grid Width="220" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Fuel -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="FUEL" Foreground="#AAFFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding FuelLevel}"
                                     Height="10" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding FuelLevel, StringFormat={}{0:P0}}"
                                   Foreground="#66FFFFFF" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#11FFFFFF" CornerRadius="8"/>

                    <!-- Coolant -->
                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="COOLANT" Foreground="#AAFFFFFF" FontSize="12" HorizontalAlignment="Center"/>
                        <ProgressBar Minimum="20" Maximum="120" Value="{Binding CoolantTempC}"
                                     Height="10" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding CoolantTempC, StringFormat={}{0:0}°C}"
                                   Foreground="#66FFFFFF" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- LEFT: RPM GAUGE -->
        <controls:RpmGauge Grid.Column="0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Width="600"
                           Height="600"
                           Style="{StaticResource FloatingGaugeStyle}"
                           Rpm="{Binding Rpm}"
                           MaxRpm="8000"
                           VtecStartRpm="3000"
                           ShiftRpm="7800" />

        <!-- RIGHT: SPEED GAUGE -->
        <controls:SpeedGauge Grid.Column="1"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Bottom"
                             Width="600"
                             Height="600"
                             Style="{StaticResource FloatingGaugeStyle}"
                             Speed="{Binding Speed}"
                             Gear="{Binding Gear}"
                             MaxSpeed="170" />
    </Grid>
</Window>